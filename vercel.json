{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/kits/:slug/index.html",
      "destination": "/kits/:slug/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "caixa-prata"
        }
      ],
      "destination": "/kits/caixa-prata/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "laco-de-natal"
        }
      ],
      "destination": "/kits/laco-de-natal/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "feliz-natal"
        }
      ],
      "destination": "/kits/feliz-natal/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "laco-tropical"
        }
      ],
      "destination": "/kits/laco-tropical/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "especiarias-de-natal"
        }
      ],
      "destination": "/kits/especiarias-de-natal/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "quarteto-de-aromas"
        }
      ],
      "destination": "/kits/quarteto-de-aromas/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "aromas-do-jardim"
        }
      ],
      "destination": "/kits/aromas-do-jardim/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "aroma-dourado"
        }
      ],
      "destination": "/kits/aroma-dourado/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "raio-de-sol"
        }
      ],
      "destination": "/kits/raio-de-sol/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "presente-variado"
        }
      ],
      "destination": "/kits/presente-variado/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "oleo-de-semente-de-uva"
        }
      ],
      "destination": "/kits/oleo-de-semente-de-uva/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "vela-de-panetone"
        }
      ],
      "destination": "/kits/vela-de-panetone/",
      "statusCode": 301
    },
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k",
          "value": "vela-gingerbread"
        }
      ],
      "destination": "/kits/vela-gingerbread/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kit.html",
      "has": [
        {
          "type": "query",
          "key": "k"
        }
      ],
      "destination": "/kits/kit-inexistente/"
    }
  ]
}
